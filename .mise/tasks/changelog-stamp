#!/usr/bin/env bash
#MISE description="Stamp the unreleased CHANGELOG section with a version and date, then start a fresh one"
#
# Usage:
#   mise run changelog-stamp <version> <YYYY-MM-DD>
#
# Rewrites `## [Unreleased]` into `## [<version>] - <date>` and inserts a fresh
# empty `## [Unreleased]` above it. Everything that was under the unreleased
# heading - including the repeated subsection headings accumulated before this
# convention existed - stays under the stamped version as history.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root"

changelog="${CHANGELOG_FILE:-$root/CHANGELOG.md}"

version="${1:-}"
date="${2:-}"

if [ -z "$version" ] || [ -z "$date" ]; then
  echo "usage: mise run changelog-stamp <version> <YYYY-MM-DD>" >&2
  exit 2
fi

if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "error: version must be X.Y.Z (got '$version')" >&2
  exit 1
fi
if ! printf '%s' "$date" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
  echo "error: date must be YYYY-MM-DD (got '$date')" >&2
  exit 1
fi

[ -f "$changelog" ] || { echo "error: no changelog at $changelog" >&2; exit 1; }

if ! grep -qE '^## \[Unreleased\]$' "$changelog"; then
  echo "error: no '## [Unreleased]' heading in $changelog" >&2
  exit 1
fi
if grep -qE "^## \[$version\]" "$changelog"; then
  echo "error: $changelog already has a section for $version" >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

awk -v version="$version" -v date="$date" '
  /^## \[Unreleased\]$/ {
    print "## [Unreleased]"
    print ""
    print "### Added"
    print ""
    print "### Changed"
    print ""
    print "### Fixed"
    print ""
    print "## [" version "] - " date
    next
  }
  { print }
' "$changelog" >"$tmp"

mv "$tmp" "$changelog"
echo "stamped $version ($date) in $changelog"
