#!/usr/bin/env bash
#MISE description="Stage both release binaries under a non-PATH candidate prefix (never touches the installed Go wsg or the qwe alias)"
#
# Usage:
#   mise run install-candidate [prefix]      # default prefix: dist/candidate
#
# Candidate installation is separate from promotion. This task does NOT install
# to ~/.local/bin, does NOT replace the legacy Go wsg binary, and does NOT touch
# the qwe alias. The owner promotes from this prefix after ticket 25 approval.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$root"

prefix="${1:-$root/dist/candidate}"
case "$prefix" in
  /*) : ;;
  *) prefix="$root/$prefix" ;;
esac

jjfx_version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
wsg_version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/wsg/Cargo.toml | head -1)

echo "==> building jjfx $jjfx_version + wsg $wsg_version (release, host)"
cargo build --release --config profile.release.strip=true -p jjfx -p wsg

mkdir -p "$prefix/bin"
install -m 0755 target/release/jjfx "$prefix/bin/jjfx"
install -m 0755 target/release/wsg "$prefix/bin/wsg"

cat >"$prefix/README.txt" <<EOF
Candidate jjfx/wsg installation for owner validation (ticket 25).

  prefix:  $prefix
  jjfx:    $prefix/bin/jjfx  ($jjfx_version)
  wsg:     $prefix/bin/wsg   ($wsg_version)

This prefix is intentionally NOT on PATH. It does not replace the installed Go
wsg (~/.local/bin/wsg) or the qwe alias. Promotion is an owner decision.
EOF

echo "==> staged candidate binaries in $prefix/bin"
echo "    jjfx: $("$prefix/bin/jjfx" --version)"
echo "    wsg:  $("$prefix/bin/wsg" version)"
